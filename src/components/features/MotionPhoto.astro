---
interface Props {
	src?: string;
	video?: string;
	alt?: string;
}

const { src, video, alt = "动态照片" } = Astro.props;
---


{src && video && <motion-photo data-src={src} data-video={video} data-alt={alt}>
	<button type="button" class="motion-photo-trigger" aria-label={`播放动态照片：${alt}`}>
		<img src={src} alt={alt} loading="lazy" decoding="async" />
		<span class="motion-photo-play" aria-hidden="true">▶</span>
	</button>
</motion-photo>}

<style is:global>
	motion-photo { display: block; position: relative; max-width: 100%; overflow: hidden; border-radius: var(--radius-medium, 0.75rem); }
	.motion-photo-trigger { display: block; position: relative; width: 100%; padding: 0; border: 0; background: #111; cursor: pointer; }
	.motion-photo-trigger img { display: block; width: 100%; height: auto; }
	.motion-photo-play { position: absolute; inset: 50% auto auto 50%; transform: translate(-50%, -50%); display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50%; color: white; background: #0009; font-size: 1.2rem; padding-left: .15rem; }
	motion-photo video { display: block; width: 100%; height: auto; max-height: 80vh; background: #111; }
</style>

<script>
	if (!customElements.get("motion-photo")) {
		customElements.define(
			"motion-photo",
			class extends HTMLElement {
				connectedCallback() {
					if (this.dataset.ready) return;
					const src = this.dataset.src || this.getAttribute("src") || "";
					const videoSrc = this.dataset.video || this.getAttribute("video") || "";
					const alt = this.dataset.alt || this.getAttribute("alt") || "动态照片";
					if (!src || !videoSrc) return;
					this.dataset.src = src;
					this.dataset.video = videoSrc;
					this.dataset.alt = alt;
					let trigger = this.querySelector("button");
					if (!trigger) {
						trigger = document.createElement("button");
						trigger.type = "button";
						trigger.className = "motion-photo-trigger";
						trigger.setAttribute("aria-label", `播放动态照片：${alt}`);
						const image = document.createElement("img");
						image.src = src;
						image.alt = alt;
						image.loading = "lazy";
						image.decoding = "async";
						const play = document.createElement("span");
						play.className = "motion-photo-play";
						play.setAttribute("aria-hidden", "true");
						play.textContent = "▶";
						trigger.append(image, play);
						this.replaceChildren(trigger);
					}
					this.dataset.ready = "true";
					trigger?.addEventListener("click", () => {
						const video = document.createElement("video");
						video.src = videoSrc;
						video.poster = src;
						video.autoplay = true;
						video.playsInline = true;
						video.preload = "metadata";
						video.setAttribute("aria-label", this.dataset.alt || "动态照片");
						video.addEventListener("ended", () => this.replaceChildren(trigger));
						video.addEventListener("error", () => this.replaceChildren(trigger), { once: true });
						this.replaceChildren(video);
						void video.play().catch(() => {
							video.muted = true;
							void video.play().catch(() => this.replaceChildren(trigger));
						});
					});
				}
			},
		);
	}
</script>
