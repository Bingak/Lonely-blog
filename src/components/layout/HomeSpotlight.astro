---
import { getCollection } from "astro:content";
import { backgroundWallpaper, coverImageConfig } from "@/config";
import { getSortedPosts, getSortedProjects } from "@/utils/content-utils";
import { dynamicPlainText, dynamicSlug, sortDynamics } from "@/utils/dynamic-utils";
import { processCoverImageSync } from "@/utils/image-utils";
import { resolveProjectImage } from "@/utils/projects-utils";
import { getPostUrlBySlug, removeFileExtension, url } from "@/utils/url-utils";

const wallpaperSource = backgroundWallpaper.src;
const wallpaperUrls = Array.isArray(wallpaperSource)
	? wallpaperSource
	: typeof wallpaperSource === "string"
		? [wallpaperSource]
		: [wallpaperSource.desktop, wallpaperSource.mobile].flatMap((source) =>
				Array.isArray(source) ? source : source ? [source] : [],
			);
const spotlightWallpapers = [...new Set([
	...wallpaperUrls,
	...coverImageConfig.randomCoverImage.apis,
])].filter((imageUrl) => /^https?:\/\//i.test(imageUrl));

const dynamics = sortDynamics(await getCollection("dynamic"))
	.map((entry) => ({
		text: dynamicPlainText(entry),
		url: url(`/dynamic/#dynamic-${dynamicSlug(entry.id).replace(/[^a-zA-Z0-9_-]/g, "-")}`),
	}))
	.filter((entry) => entry.text);

const projects = await Promise.all(
	(await getSortedProjects()).map(async (entry) => ({
		title: entry.data.title,
		description: entry.data.description,
		image: await resolveProjectImage(entry.data.image, entry.id),
		url: url(`/projects/${removeFileExtension(entry.id)}/`),
	})),
);

const posts = (await getSortedPosts())
	.filter((entry) => !entry.data.password)
	.map((entry) => ({
		title: entry.data.title,
		description: entry.data.description,
		image: processCoverImageSync(entry.data.image, entry.id),
		url: getPostUrlBySlug(entry.id),
	}));

const initialDynamic = dynamics[0];
const initialProject = projects[0];
const initialPost = posts[0];
---

{(dynamics.length > 0 || projects.length > 0 || posts.length > 0) && (
	<section
		class="home-spotlight onload-animation"
		aria-label="首页随机推荐"
		data-dynamics={JSON.stringify(dynamics)}
		data-projects={JSON.stringify(projects)}
		data-posts={JSON.stringify(posts)}
		data-wallpapers={JSON.stringify(spotlightWallpapers)}
	>
		{initialDynamic && (
			<a class="spotlight-dynamic" data-dynamic-link href={initialDynamic.url}>
				<span class="spotlight-eyebrow"><span class="spotlight-pulse"></span> 动态速览</span>
				<span class="spotlight-dynamic-text" data-dynamic-text>{initialDynamic.text}</span>
				<span class="spotlight-arrow" aria-hidden="true">↗</span>
			</a>
		)}

		<div class="spotlight-showcase">
			<img class="spotlight-showcase-wallpaper" data-showcase-wallpaper alt="" aria-hidden="true" />
			<img class="spotlight-showcase-wallpaper" data-showcase-wallpaper alt="" aria-hidden="true" />
			<span class="spotlight-showcase-shade" aria-hidden="true"></span>
			<div class="spotlight-showcase-heading">
				<span class="spotlight-showcase-mark" aria-hidden="true"><span></span><span></span><span></span></span>
				<div><strong>灵感漫游</strong><span>从一篇文章或一个项目开始</span></div>
				<span class="spotlight-showcase-caption">随机发现 <span aria-hidden="true">✦</span></span>
			</div>
			<div class="spotlight-feature-grid">
			{initialPost && (
				<article class="spotlight-feature spotlight-post" data-feature="post">
					<a class="spotlight-feature-link" data-feature-link href={initialPost.url}>
						<img class="spotlight-image" data-feature-image src={initialPost.image || undefined} alt="" loading="lazy" />
						<span class="spotlight-image-shade"></span>
						<span class="spotlight-feature-copy">
							<span class="spotlight-eyebrow">随机阅读 · 博文</span>
							<strong data-feature-title>{initialPost.title}</strong>
							<span data-feature-description>{initialPost.description || "从一篇文章开始探索"}</span>
						</span>
					</a>
					<button class="spotlight-reroll" type="button" data-reroll="post" aria-label="随机换一篇博文">换一篇 <span aria-hidden="true">↻</span></button>
				</article>
			)}

			{initialProject && (
				<article class="spotlight-feature spotlight-project" data-feature="project">
					<a class="spotlight-feature-link" data-feature-link href={initialProject.url}>
						<img class="spotlight-image" data-feature-image src={initialProject.image || undefined} alt="" loading="lazy" />
						<span class="spotlight-image-shade"></span>
						<span class="spotlight-feature-copy">
							<span class="spotlight-eyebrow">随手逛逛 · 项目</span>
							<strong data-feature-title>{initialProject.title}</strong>
							<span data-feature-description>{initialProject.description || "看看我最近做的小项目"}</span>
						</span>
					</a>
					<button class="spotlight-reroll" type="button" data-reroll="project" aria-label="随机换一个项目">换一个 <span aria-hidden="true">↻</span></button>
				</article>
			)}
			</div>
			<nav class="spotlight-quick-links" aria-label="快捷入口">
				<a href={url("/dynamic/")}><span class="spotlight-quick-icon" aria-hidden="true">✎</span><span>日记</span></a>
				<a href={url("/archive/")}><span class="spotlight-quick-icon" aria-hidden="true">▤</span><span>文章归档</span></a>
				<a href={url("/about/")}><span class="spotlight-quick-icon" aria-hidden="true">✦</span><span>关于我</span></a>
			</nav>
		</div>
	</section>
)}

<script>
	let spotlightTimer: number | undefined;
	let wallpaperTimer: number | undefined;

	const initHomeSpotlight = () => {
		const root = document.querySelector<HTMLElement>(".home-spotlight");
		if (!root) {
			if (spotlightTimer !== undefined) window.clearInterval(spotlightTimer);
			if (wallpaperTimer !== undefined) window.clearInterval(wallpaperTimer);
			spotlightTimer = undefined;
			wallpaperTimer = undefined;
			return;
		}
		if (root.dataset.initialized === "true") return;
		if (spotlightTimer !== undefined) window.clearInterval(spotlightTimer);
		if (wallpaperTimer !== undefined) window.clearInterval(wallpaperTimer);
		spotlightTimer = undefined;
		wallpaperTimer = undefined;
		root.dataset.initialized = "true";

		const parse = <T,>(value: string | undefined): T[] => {
			try {
				return value ? JSON.parse(value) as T[] : [];
			} catch {
				return [];
			}
		};
		const dynamics = parse<{ text: string; url: string }>(root.dataset.dynamics);
		const projects = parse<{ title: string; description: string; image: string; url: string }>(root.dataset.projects);
		const posts = parse<{ title: string; description: string; image: string; url: string }>(root.dataset.posts);
		const wallpapers = parse<string>(root.dataset.wallpapers);
		let lastDynamic = -1;
		const pick = <T,>(items: T[], previous = -1): number => {
			if (items.length < 2) return 0;
			let index = Math.floor(Math.random() * items.length);
			if (index === previous) index = (index + 1 + Math.floor(Math.random() * (items.length - 1))) % items.length;
			return index;
		};

		const showDynamic = () => {
			if (!dynamics.length) return;
			lastDynamic = pick(dynamics, lastDynamic);
			const item = dynamics[lastDynamic];
			const link = root.querySelector<HTMLAnchorElement>("[data-dynamic-link]");
			const text = root.querySelector<HTMLElement>("[data-dynamic-text]");
			if (link) link.href = item.url;
			if (text) {
				text.classList.add("is-changing");
				window.setTimeout(() => {
					text.textContent = item.text;
					text.classList.remove("is-changing");
				}, 180);
			}
		};

		const wallpaperImages = Array.from(root.querySelectorAll<HTMLImageElement>("[data-showcase-wallpaper]"));
		if (wallpaperImages.length && wallpapers.length) {
			let lastWallpaper = -1;
			const showWallpaper = () => {
				const activeImage = wallpaperImages.findIndex((image) => image.classList.contains("is-active"));
				const nextImage = wallpaperImages[activeImage === 0 ? 1 : 0];
				const selectedWallpaper = pick(wallpapers, lastWallpaper);
				let failedAttempts = 0;
				const loadWallpaper = (index: number) => {
					nextImage.onload = () => {
						lastWallpaper = index;
						nextImage.classList.add("is-active");
						if (activeImage >= 0) wallpaperImages[activeImage].classList.remove("is-active");
						nextImage.onload = null;
						nextImage.onerror = null;
					};
					nextImage.onerror = () => {
						failedAttempts += 1;
						if (failedAttempts >= wallpapers.length) return;
						loadWallpaper((selectedWallpaper + failedAttempts) % wallpapers.length);
					};
					nextImage.src = wallpapers[index];
				};
				loadWallpaper(selectedWallpaper);
			};
			showWallpaper();
			if (wallpapers.length > 1) wallpaperTimer = window.setInterval(showWallpaper, 5000);
		}

		showDynamic();
		if (dynamics.length > 1) spotlightTimer = window.setInterval(showDynamic, 5000);

		const showFeature = (kind: "project" | "post", animate = false) => {
			const items = kind === "project" ? projects : posts;
			const card = root.querySelector<HTMLElement>(`[data-feature="${kind}"]`);
			if (!items.length || !card) return;
			if (animate && card.dataset.rerolling === "true") return;
			const previous = Number(card.dataset.currentIndex ?? -1);
			const index = pick(items, previous);
			const item = items[index];
			const link = card.querySelector<HTMLAnchorElement>("[data-feature-link]");
			const image = card.querySelector<HTMLImageElement>("[data-feature-image]");
			const title = card.querySelector<HTMLElement>("[data-feature-title]");
			const description = card.querySelector<HTMLElement>("[data-feature-description]");
			let imageLoadFallback: number | undefined;
			const finishAnimation = () => {
				if (imageLoadFallback !== undefined) window.clearTimeout(imageLoadFallback);
				card.classList.remove("is-rerolling");
				delete card.dataset.rerolling;
			};
			const applySelection = () => {
				card.dataset.currentIndex = String(index);
				if (link) link.href = item.url;
				if (image) {
					image.onload = null;
					image.onerror = null;
					if (item.image) {
						image.hidden = false;
						if (animate && image.src !== new URL(item.image, window.location.href).href) {
							image.onload = finishAnimation;
							image.onerror = finishAnimation;
							image.src = item.image;
							imageLoadFallback = window.setTimeout(finishAnimation, 500);
							if (image.complete) window.requestAnimationFrame(finishAnimation);
						} else {
							image.src = item.image;
							finishAnimation();
						}
					} else {
						image.removeAttribute("src");
						image.hidden = true;
						finishAnimation();
					}
				} else {
					finishAnimation();
				}
				if (title) title.textContent = item.title;
				if (description) description.textContent = item.description || (kind === "project" ? "看看我最近做的小项目" : "从一篇文章开始探索");
			};

			if (animate) {
				card.dataset.rerolling = "true";
				card.classList.add("is-rerolling");
				window.setTimeout(applySelection, 220);
			} else {
				applySelection();
			}
		};

		root.querySelectorAll<HTMLButtonElement>("[data-reroll]").forEach((button) => {
			button.addEventListener("click", () => showFeature(button.dataset.reroll as "project" | "post", true));
		});
		showFeature("project");
		showFeature("post");
	};

	initHomeSpotlight();
	document.addEventListener("astro:page-load", initHomeSpotlight);
</script>

<style>
	.home-spotlight {
		--spotlight-border: color-mix(in srgb, var(--primary) 34%, transparent);
		display: grid;
		gap: 0.7rem;
		margin: 0 0 1rem;
	}

	.spotlight-dynamic {
		position: relative;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.85rem;
		min-height: 4.25rem;
		padding: 0.85rem 1.1rem;
		border: 1px solid var(--spotlight-border);
		border-radius: 1.15rem;
		background: linear-gradient(112deg, rgb(27 31 53 / 97%), rgb(27 31 53 / 91%));
		box-shadow: 0 12px 32px rgb(15 18 35 / 22%), inset 0 1px 0 rgb(255 255 255 / 9%);
		backdrop-filter: blur(18px);
		text-decoration: none;
		color: #fff;
		transition: border-color 220ms ease, transform 220ms ease, box-shadow 220ms ease;
	}

	.spotlight-dynamic:hover,
	.spotlight-feature:hover {
		transform: translateY(-2px);
		border-color: color-mix(in srgb, var(--primary) 64%, transparent);
		box-shadow: 0 12px 34px rgb(0 0 0 / 17%);
	}

	.spotlight-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--primary);
		font-size: 0.78rem;
		font-weight: 750;
		letter-spacing: 0.035em;
		white-space: nowrap;
	}

	.spotlight-pulse {
		width: 0.48rem;
		height: 0.48rem;
		border-radius: 50%;
		background: var(--primary);
		box-shadow: 0 0 0 0 color-mix(in srgb, var(--primary) 35%, transparent);
		animation: spotlight-pulse 1.8s ease-out infinite;
	}

	.spotlight-dynamic-text {
		display: -webkit-box;
		overflow: hidden;
		color: #fff;
		font-size: 0.94rem;
		font-weight: 600;
		line-height: 1.55;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 1;
		transition: opacity 180ms ease, transform 180ms ease;
	}

	.spotlight-dynamic-text.is-changing {
		opacity: 0;
		transform: translateY(4px);
	}

	.spotlight-arrow {
		display: grid;
		width: 2rem;
		height: 2rem;
		place-items: center;
		border-radius: 50%;
		background: color-mix(in srgb, var(--primary) 15%, transparent);
		color: var(--primary);
		font-size: 1.1rem;
	}

	.spotlight-showcase {
		position: relative;
		overflow: hidden;
		padding: 0.35rem;
		border: 1px solid rgb(255 255 255 / 45%);
		border-radius: 1.7rem;
		background: linear-gradient(135deg, #252942, #24253a);
		box-shadow: 0 18px 50px rgb(13 15 29 / 27%), inset 0 1px 0 rgb(255 255 255 / 12%);
	}

	.spotlight-showcase-wallpaper {
		position: absolute;
		z-index: 0;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		filter: saturate(1.14) brightness(1.12) blur(1px);
		transform: scale(1.035);
		transition: opacity 1.1s ease-in-out;
		pointer-events: none;
	}

	.spotlight-showcase-wallpaper.is-active { opacity: 0.92; }

	.spotlight-showcase-shade {
		position: absolute;
		z-index: 1;
		inset: 0;
		background: linear-gradient(120deg, rgb(20 23 43 / 34%), rgb(26 26 43 / 42%));
		pointer-events: none;
	}

	.spotlight-showcase-heading {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.7rem 1rem 0.85rem;
		color: white;
		text-shadow: 0 1px 8px rgb(10 12 25 / 65%);
	}

	.spotlight-showcase-heading > div { display: grid; gap: 0.1rem; }
	.spotlight-showcase-heading > div strong { font-size: 1.05rem; letter-spacing: 0.04em; }
	.spotlight-showcase-heading > div span { color: rgb(235 236 255 / 64%); font-size: 0.75rem; }

	.spotlight-showcase-mark {
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		padding: 0.45rem;
		border: 1px solid rgb(255 255 255 / 13%);
		border-radius: 0.8rem;
		background: linear-gradient(145deg, rgb(161 145 255 / 27%), rgb(90 199 220 / 12%));
	}

	.spotlight-showcase-mark span { width: 0.22rem; height: 0.85rem; border-radius: 1rem; background: linear-gradient(#b8aaff, #6ee2dd); }
	.spotlight-showcase-mark span:nth-child(2) { height: 1.15rem; }
	.spotlight-showcase-mark span:nth-child(3) { height: 0.62rem; }

	.spotlight-showcase-caption {
		margin-left: auto;
		padding: 0.4rem 0.7rem;
		border: 1px solid rgb(255 255 255 / 12%);
		border-radius: 999px;
		background: rgb(255 255 255 / 5%);
		color: rgb(230 231 255 / 75%);
		font-size: 0.72rem;
		letter-spacing: 0.06em;
	}

	.spotlight-showcase-caption span { color: #ffd891; }

	.spotlight-feature-grid {
		position: relative;
		z-index: 2;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.8rem;
		padding: 0 0.45rem 0.45rem;
	}

	.spotlight-quick-links {
		position: relative;
		z-index: 2;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.65rem;
		padding: 0 0.45rem 0.45rem;
	}

	.spotlight-quick-links a {
		display: flex;
		min-height: 3.1rem;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		border: 1px solid rgb(255 255 255 / 22%);
		border-radius: 0.95rem;
		background: rgb(15 18 31 / 47%);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 9%);
		backdrop-filter: blur(14px);
		color: white;
		font-size: 0.86rem;
		font-weight: 700;
		text-decoration: none;
		transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
	}

	.spotlight-quick-links a:hover {
		transform: translateY(-2px);
		border-color: rgb(255 255 255 / 48%);
		background: rgb(91 94 145 / 58%);
	}

	.spotlight-quick-links a:nth-child(1) { background-image: linear-gradient(110deg, rgb(49 156 212 / 29%), rgb(15 18 31 / 40%)); }
	.spotlight-quick-links a:nth-child(2) { background-image: linear-gradient(110deg, rgb(236 138 92 / 28%), rgb(15 18 31 / 40%)); }
	.spotlight-quick-links a:nth-child(3) { background-image: linear-gradient(110deg, rgb(59 193 158 / 28%), rgb(15 18 31 / 40%)); }
	.spotlight-quick-icon { color: #c2b8ff; font-size: 1.15rem; line-height: 1; }
	.spotlight-quick-links a:nth-child(1) .spotlight-quick-icon { color: #8ce0ff; }
	.spotlight-quick-links a:nth-child(2) .spotlight-quick-icon { color: #ffc19e; }
	.spotlight-quick-links a:nth-child(3) .spotlight-quick-icon { color: #9ef2d2; }

	.spotlight-feature {
		position: relative;
		min-height: clamp(13rem, 23vw, 18rem);
		overflow: hidden;
		border: 1px solid rgb(255 255 255 / 18%);
		border-radius: 1.35rem;
		background: radial-gradient(ellipse at 85% 8%, rgb(var(--feature-accent) / 32%), transparent 48%), linear-gradient(140deg, #20243a, #151725 80%);
		box-shadow: 0 10px 28px rgb(0 0 0 / 22%), inset 0 1px 0 rgb(255 255 255 / 8%);
		transition: border-color 220ms ease, transform 220ms ease, box-shadow 220ms ease;
		isolation: isolate;
	}

	.spotlight-project { --feature-accent: 255 169 88; }
	.spotlight-post { --feature-accent: 139 119 255; }

	.spotlight-project::after,
	.spotlight-post::after {
		position: absolute;
		z-index: 0;
		right: -1.25rem;
		bottom: -3rem;
		color: rgb(var(--feature-accent) / 15%);
		font-size: 12rem;
		font-weight: 850;
		line-height: 1;
		pointer-events: none;
	}

	.spotlight-project::after { content: "⌘"; }
	.spotlight-post::after { content: "✦"; right: 0.4rem; bottom: -2.9rem; font-size: 10rem; }

	.spotlight-feature-link {
		position: absolute;
		z-index: 1;
		inset: 0;
		display: flex;
		align-items: flex-end;
		padding: clamp(1rem, 2vw, 1.5rem);
		color: white;
		text-decoration: none;
		transition: opacity 220ms ease, transform 220ms ease;
	}

	.spotlight-feature.is-rerolling .spotlight-feature-link {
		opacity: 0;
		transform: translateY(7px) scale(0.99);
	}

	.spotlight-image {
		position: absolute;
		z-index: 0;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 450ms ease;
	}

	.spotlight-image[hidden] { display: none; }
	.spotlight-feature:hover .spotlight-image { transform: scale(1.045); }

	.spotlight-image-shade {
		position: absolute;
		z-index: 1;
		inset: 0;
		background: linear-gradient(90deg, rgb(12 14 24 / 82%), rgb(12 14 24 / 38%) 72%), linear-gradient(0deg, rgb(12 14 24 / 78%), transparent 82%);
	}

	.spotlight-feature-copy {
		position: relative;
		z-index: 2;
		display: grid;
		max-width: min(88%, 38rem);
		gap: 0.55rem;
	}

	.spotlight-feature-copy strong {
		overflow: hidden;
		font-size: clamp(1.3rem, 2.2vw, 1.85rem);
		line-height: 1.2;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.spotlight-feature-copy > span:last-child {
		display: -webkit-box;
		overflow: hidden;
		color: rgb(255 255 255 / 88%);
		font-size: 0.92rem;
		line-height: 1.5;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.spotlight-reroll {
		position: absolute;
		z-index: 2;
		top: 0.8rem;
		right: 0.8rem;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.45rem 0.7rem;
		border: 1px solid rgb(255 255 255 / 26%);
		border-radius: 999px;
		background: rgb(16 18 27 / 42%);
		backdrop-filter: blur(12px);
		color: white;
		font: inherit;
		font-size: 0.76rem;
		cursor: pointer;
		transition: background 180ms ease, border-color 180ms ease;
	}

	.spotlight-reroll:hover {
		border-color: rgb(255 255 255 / 55%);
		background: rgb(16 18 27 / 72%);
	}

	@keyframes spotlight-pulse {
		75%, 100% { box-shadow: 0 0 0 0.5rem transparent; }
	}

	@media (max-width: 640px) {
		.home-spotlight { gap: 0.55rem; margin-bottom: 0.75rem; }
		.spotlight-dynamic { grid-template-columns: 1fr auto; gap: 0.4rem 0.6rem; padding: 0.75rem 0.85rem; }
		.spotlight-dynamic .spotlight-eyebrow { grid-column: 1; }
		.spotlight-dynamic-text { grid-column: 1; grid-row: 2; font-size: 0.84rem; -webkit-line-clamp: 2; }
